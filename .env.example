# ===========================================
# 실제 값을 채운 뒤 .env 로 복사해서 사용하세요.
# .env 는 git에 커밋되지 않습니다.
# ===========================================

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
# 각 서비스는 자체 기본 Database를 사용합니다. 재정의할 때만 DB_NAME을 설정하세요.
DB_USERNAME=postgres
DB_PASSWORD=changeme
DDL_AUTO=validate
SHOW_SQL=true

# --- Redis (hub-service 캐싱) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Eureka / Zipkin ---
EUREKA_URL=http://localhost:8761/eureka/
ZIPKIN_URL=http://localhost:9411/api/v2/spans

# --- JWT (user-service 발급 / gateway 검증) ---
# 256bit 이상 랜덤 시크릿 사용 권장
JWT_SECRET=replace-with-a-long-random-secret-key
JWT_ACCESS_EXPIRATION=900000

# --- AI (slack-service, Gemini Developer API) ---
# https://aistudio.google.com/apikey 에서 발급. 키가 없으면 slack-service가 기동되지 않습니다.
GEMINI_API_KEY=your-gemini-api-key
# 구글이 특정 모델 지원을 예고 없이 중단하므로(gemini-2.0-flash / gemini-2.5-flash 모두 404) 별칭 사용
GEMINI_MODEL=gemini-flash-latest

# --- Slack (slack-service) ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
